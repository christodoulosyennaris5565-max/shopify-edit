<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- comment -%}
      Default layout, used by Shopify system pages such as the spam check after a form is sent,
      search, 404 and product pages. Keeps the base theme styles for page content but uses the
      Helia Web header and footer.
    {%- endcomment -%}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='15' fill='%23141b2e'/%3E%3Ccircle cx='43' cy='22' r='12' fill='%23f5b83d'/%3E%3Crect x='9' y='24' width='38' height='30' rx='6' fill='%232c52e8'/%3E%3Crect x='9' y='24' width='38' height='8' rx='6' fill='%234b6cf0'/%3E%3Crect x='9' y='29' width='38' height='3' fill='%234b6cf0'/%3E%3Ccircle cx='14.5' cy='28' r='1.6' fill='%23fff'/%3E%3Ccircle cx='19.5' cy='28' r='1.6' fill='%23fff' opacity='.6'/%3E%3Crect x='15' y='38' width='22' height='4' rx='2' fill='%23fff'/%3E%3Crect x='15' y='45' width='14' height='4' rx='2' fill='%23fff' opacity='.55'/%3E%3C/svg%3E">
    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}
    <link rel='preconnect' href='https://fonts.googleapis.com'>
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
    <link href='https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600&display=swap' rel='stylesheet'>
    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}
    {{ content_for_header }}
  </head>

  <body style='margin: 0; background: #f2f4f8'>
    {% render 'hw-styles-1' %}
    <style>
      .hw-default { min-height: 60vh; padding-block: clamp(2rem, 6vw, 4rem); }
      .hw-default__card { max-width: 760px; margin-inline: auto; background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: clamp(1.25rem, 4vw, 2.25rem); font-family: var(--font-body); color: var(--ink); }
      .hw-default__card h1, .hw-default__card h2 { font-family: var(--font-display); }
      .hw-default__card button, .hw-default__card input[type='submit'] { background: var(--blue); color: #fff; border: 0; border-radius: var(--radius); padding: 0.9rem 1.5rem; font-weight: 600; cursor: pointer; }
      .hw .hw-foot { background: var(--navy); color: #b9c1d9; padding-block: 1.5rem; font-size: 0.9rem; }
      .hw .hw-foot .wrap { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
      .hw .hw-foot a { color: #fff; }
    </style>
    <div class='hw'>
      <header class='nav'>
        <div class='wrap nav__inner'>
          <a class='brand' href='{% if request.locale.iso_code == 'el' %}/el{% else %}/{% endif %}' aria-label='Helia Web'>
            <svg class='brand__mark' viewBox='0 0 64 64' aria-hidden='true'><rect width='64' height='64' rx='15' fill='#141b2e'/><circle cx='43' cy='22' r='12' fill='#f5b83d'/><rect x='9' y='24' width='38' height='30' rx='6' fill='#2c52e8'/><rect x='9' y='24' width='38' height='8' rx='6' fill='#4b6cf0'/><rect x='9' y='29' width='38' height='3' fill='#4b6cf0'/><circle cx='14.5' cy='28' r='1.6' fill='#fff'/><circle cx='19.5' cy='28' r='1.6' fill='#fff' opacity='.6'/><rect x='15' y='38' width='22' height='4' rx='2' fill='#fff'/><rect x='15' y='45' width='14' height='4' rx='2' fill='#fff' opacity='.55'/></svg>
            Helia&nbsp;<small>Web</small>
          </a>
          <nav class='nav__links' aria-label='Main'>
            {%- if request.locale.iso_code == 'el' -%}
              <a href='/el'>Αρχική</a>
              <a href='/el/pages/my-project'>Το έργο μου</a>
              {% render 'hw-lang' %}
              <a class='btn btn--blue nav__cta' href='/el/pages/get-a-quote'><span class='cta-long'>Ζητήστε προσφορά</span><span class='cta-short'>Προσφορά</span></a>
            {%- else -%}
              <a href='/'>Home</a>
              <a href='/pages/my-project'>My project</a>
              {% render 'hw-lang' %}
              <a class='btn btn--blue nav__cta' href='/pages/get-a-quote'>Get a quote</a>
            {%- endif -%}
          </nav>
        </div>
      </header>
    </div>

    <main id="MainContent" class="hw-default content-for-layout" role="main" data-template="{{ template }}">
      <div class='hw-default__card'>
        {{ content_for_layout }}
      </div>
    </main>

    <div class='hw'>
      <footer class='hw-foot'>
        <div class='wrap'>
          <span>Helia Web · {% if request.locale.iso_code == 'el' %}Ιστοσελίδες από €450{% else %}Websites from €450{% endif %}</span>
          <span><a href='tel:+35799238575'>+357 99 238575</a> · <a href='mailto:christodoulos@heliaweb.com'>christodoulos@heliaweb.com</a></span>
        </div>
      </footer>
    </div>
  </body>
</html>
