{%- comment -%} Branded cart page (checkout's cart button links here). Uses layout/hw.liquid. English and Greek (/el). {%- endcomment -%}
{%- liquid
  assign el = false
  assign L = ''
  if request.locale.iso_code == 'el'
    assign el = true
    assign L = '/el'
  endif
-%}
<div class='hw qt-page'>
  <header class='nav'>
    <div class='wrap nav__inner'>
      <a class='brand' href='{{ L }}/' aria-label='Helia Web'>
        <svg class='brand__mark' viewBox='0 0 64 64' aria-hidden='true'><rect width='64' height='64' rx='15' fill='#141b2e'/><circle cx='43' cy='22' r='12' fill='#f5b83d'/><rect x='9' y='24' width='38' height='30' rx='6' fill='#2c52e8'/><rect x='9' y='24' width='38' height='8' rx='6' fill='#4b6cf0'/><rect x='9' y='29' width='38' height='3' fill='#4b6cf0'/><circle cx='14.5' cy='28' r='1.6' fill='#fff'/><circle cx='19.5' cy='28' r='1.6' fill='#fff' opacity='.6'/><rect x='15' y='38' width='22' height='4' rx='2' fill='#fff'/><rect x='15' y='45' width='14' height='4' rx='2' fill='#fff' opacity='.55'/></svg>
        Helia&nbsp;<small>Web</small>
      </a>
      <nav class='nav__links' aria-label='{% if el %}Κύριο μενού{% else %}Main{% endif %}'>
        <a href='{{ L }}/'>{% if el %}Πίσω στην ιστοσελίδα{% else %}Back to site{% endif %}</a>
        <a href='{{ L }}/pages/my-project'>{% if el %}Το έργο μου{% else %}My project{% endif %}</a>
        {% render 'hw-lang' %}
        <a class='btn btn--blue nav__cta' href='tel:+35799238575'>{% if el %}Καλέστε με{% else %}Call me{% endif %}</a>
      </nav>
    </div>
  </header>
  <main class='qt'>
    <div class='wrap' style='max-width: 720px'>
      <div class='qt__head'>
        <span class='eyebrow'>{% if el %}Η παραγγελία σας{% else %}Your order{% endif %}</span>
        <h1>
          {%- if cart.item_count > 0 -%}
            {% if el %}Έτοιμο για πληρωμή{% else %}Ready to pay{% endif %}
          {%- else -%}
            {% if el %}Δεν υπάρχει κάτι για πληρωμή{% else %}Nothing to pay yet{% endif %}
          {%- endif -%}
        </h1>
      </div>
      <div class='qt__card'>
        {%- if cart.item_count > 0 -%}
          <dl class='qt__review'>
            {%- for item in cart.items -%}
              <div><dt>{{ item.product.title }}{% if item.quantity > 1 %} × {{ item.quantity }}{% endif %}</dt><dd>{{ item.final_line_price | money }}</dd></div>
            {%- endfor -%}
            <div style='background: var(--navy); color: #fff'><dt style='color: #b9c1d9'>{% if el %}Πληρωτέο τώρα{% else %}Total due now{% endif %}</dt><dd>{{ cart.total_price | money }}</dd></div>
          </dl>
          <p class='qt__depnote'>{% if el %}Η προκαταβολή των €50 αφαιρείται από τη συνολική τιμή της ιστοσελίδας στον τελικό λογαριασμό.{% else %}The €50 deposit is taken off your website's total price on your final bill.{% endif %}</p>
          <div class='pj__actions' style='display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem'>
            <a class='btn btn--yellow' href='/checkout'>{% if el %}Συνέχεια στην πληρωμή{% else %}Continue to payment{% endif %}</a>
            <a class='btn btn--ghost' href='{{ L }}/pages/my-project'>{% if el %}Το έργο μου{% else %}My project{% endif %}</a>
          </div>
        {%- else -%}
          <p class='qt__hint'>{% if el %}Για να ξεκινήσετε, φτιάξτε την προσφορά σας. Αφού τη στείλετε, μπορείτε να καταβάλετε την προκαταβολή των €50.{% else %}To get started, build your quote. After you send it, you can place your €50 deposit.{% endif %}</p>
          <div style='display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem'>
            <a class='btn btn--blue' href='{{ L }}/pages/get-a-quote'>{% if el %}Φτιάξτε την ιστοσελίδα σας{% else %}Build your website{% endif %}</a>
            <a class='btn btn--ghost' href='{{ L }}/pages/my-project'>{% if el %}Το έργο μου{% else %}My project{% endif %}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </main>
</div>

{% schema %}
{
  "name": "Helia Web cart",
  "settings": []
}
{% endschema %}
