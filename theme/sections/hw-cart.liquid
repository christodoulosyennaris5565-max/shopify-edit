{%- comment -%} Branded cart page (checkout's cart button links here). Uses layout/hw.liquid. {%- endcomment -%}
<div class='hw qt-page'>
  <header class='nav'>
    <div class='wrap nav__inner'>
      <a class='brand' href='/' aria-label='Helia Web home'>
        <svg class='brand__mark' viewBox='0 0 64 64' aria-hidden='true'><rect width='64' height='64' rx='14' fill='#2c52e8'/><path d='M17 14h8.2v14.3c2.1-2.8 5-4.2 8.6-4.2 6.1 0 9.6 4 9.6 10.7V50h-8.2V36.6c0-3.6-1.6-5.5-4.6-5.5-3.3 0-5.4 2.3-5.4 6.2V50H17z' fill='#fff'/><circle cx='50.5' cy='45.8' r='4.4' fill='#f5b83d'/></svg>
        Helia&nbsp;<small>Web</small>
      </a>
      <nav class='nav__links' aria-label='Main'>
        <a href='/'>Back to site</a>
        <a href='/pages/my-project'>My project</a>
        <a class='btn btn--blue nav__cta' href='tel:+35799238575'>Call me</a>
      </nav>
    </div>
  </header>
  <main class='qt'>
    <div class='wrap' style='max-width: 720px'>
      <div class='qt__head'>
        <span class='eyebrow'>Your order</span>
        <h1>{% if cart.item_count > 0 %}Ready to pay{% else %}Nothing to pay yet{% endif %}</h1>
      </div>
      <div class='qt__card'>
        {%- if cart.item_count > 0 -%}
          <dl class='qt__review'>
            {%- for item in cart.items -%}
              <div><dt>{{ item.product.title }}{% if item.quantity > 1 %} × {{ item.quantity }}{% endif %}</dt><dd>{{ item.final_line_price | money }}</dd></div>
            {%- endfor -%}
            <div style='background: var(--navy); color: #fff'><dt style='color: #b9c1d9'>Total due now</dt><dd>{{ cart.total_price | money }}</dd></div>
          </dl>
          <p class='qt__depnote'>The €50 deposit is taken off your website's total price on your final bill.</p>
          <div class='pj__actions' style='display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem'>
            <a class='btn btn--yellow' href='/checkout'>Continue to payment</a>
            <a class='btn btn--ghost' href='/pages/my-project'>My project</a>
          </div>
        {%- else -%}
          <p class='qt__hint'>To get started, build your quote. After you send it, you can place your €50 deposit.</p>
          <div style='display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem'>
            <a class='btn btn--blue' href='/pages/get-a-quote'>Build your website</a>
            <a class='btn btn--ghost' href='/pages/my-project'>My project</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </main>
</div>

{% schema %}
{
  "name": "Helia Web cart",
  "settings": []
}
{% endschema %}
