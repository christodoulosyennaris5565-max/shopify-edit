{%- comment -%}
  Greek copy of pj-body (My project page). Stage comes from the customer's "Project stage" metafield (custom.project_stage),
  set in Shopify admin > Customers. Paying the Website deposit product moves it to In production automatically.
{%- endcomment -%}
{%- assign deposit_product_id = 15991257334144 -%}
<div class='hw qt-page'>
  <header class='nav'>
    <div class='wrap nav__inner'>
      <a class='brand' href='/el' aria-label='Helia Web αρχική'>
        <svg class='brand__mark' viewBox='0 0 64 64' aria-hidden='true'><rect width='64' height='64' rx='14' fill='#2c52e8'/><path d='M17 14h8.2v14.3c2.1-2.8 5-4.2 8.6-4.2 6.1 0 9.6 4 9.6 10.7V50h-8.2V36.6c0-3.6-1.6-5.5-4.6-5.5-3.3 0-5.4 2.3-5.4 6.2V50H17z' fill='#fff'/><circle cx='50.5' cy='45.8' r='4.4' fill='#f5b83d'/></svg>
        Helia&nbsp;<small>Web</small>
      </a>
      <nav class='nav__links' aria-label='Κύριο μενού'>
        <a href='/el'>Πίσω στην ιστοσελίδα</a>
        {%- if customer -%}<a href='{{ routes.account_logout_url }}'>Αποσύνδεση</a>{%- endif -%}
        {% render 'hw-lang' %}
        <a class='btn btn--blue nav__cta' href='tel:+35799238575'>Καλέστε με</a>
      </nav>
    </div>
  </header>

  <main class='qt'>
    <div class='wrap' style='max-width: 820px'>
      <div class='qt__head'>
        <span class='eyebrow'>Το έργο μου</span>
        <h1>{% if customer and customer.first_name != blank %}Γεια σας {{ customer.first_name }}, αυτό είναι το έργο σας{% else %}Παρακολουθήστε το έργο σας{% endif %}</h1>
      </div>

      <div class='qt__card'>
        {%- if customer -%}
          {%- liquid
            assign stage = customer.metafields.custom.project_stage.value | default: ''
            assign paid = false
            for order in customer.orders
              for item in order.line_items
                if item.product_id == deposit_product_id and order.financial_status == 'paid'
                  assign paid = true
                endif
              endfor
            endfor
            assign call = false
            case stage
              when 'Website live'
                assign p = 4
              when 'In production'
                assign p = 3
              when 'Awaiting deposit'
                assign p = 2
              when 'Call requested'
                assign p = 2
                assign call = true
              else
                assign p = 1
            endcase
            if paid and p < 3
              assign p = 3
              assign call = false
            endif
            case p
              when 4
                assign status = 'Η ιστοσελίδα σας είναι online!'
                assign detail = 'Σας ευχαριστώ για τη συνεργασία. Αν χρειάζεστε αλλαγές, επικοινωνήστε μαζί μου.'
              when 3
                assign status = 'Η ιστοσελίδα σας είναι σε παραγωγή'
                assign detail = 'Η προκαταβολή σας ελήφθη και φτιάχνω την ιστοσελίδα σας.'
              when 2
                if call
                  assign status = 'Ζητήθηκε κλήση'
                  assign detail = 'Θα σας καλέσω σύντομα για να συζητήσουμε την ιστοσελίδα σας. Μπορείτε επίσης να καταβάλετε την προκαταβολή οποιαδήποτε στιγμή για να ξεκινήσουμε.'
                else
                  assign status = 'Αναμένεται η προκαταβολή σας'
                  assign detail = 'Καταβάλετε την προκαταβολή των €50 για να κλείσετε τη θέση σας και η ιστοσελίδα σας μπαίνει σε παραγωγή.'
                endif
              else
                assign status = 'Η προσφορά στάλθηκε'
                assign detail = 'Έλαβα το αίτημα προσφοράς σας. Θέλετε να προχωρήσετε; Καταβάλετε την προκαταβολή ή καλέστε με για να το συζητήσουμε.'
            endcase
          -%}
          <div class='pj__status'>
            <small>Τρέχον στάδιο</small>
            <h2>{{ status }}</h2>
            <p>{{ detail }}</p>
          </div>
          {% render 'qt-tracker', p: p, call: call, id: 'pj-trk' %}

          <dl class='qt__review'>
            {%- assign ptype = customer.metafields.custom.project_type.value -%}
            {%- if ptype and ptype != '' -%}<div><dt>Ιστοσελίδα</dt><dd>{{ ptype }}</dd></div>{%- endif -%}
            {%- assign fq = customer.metafields.custom.final_quote.value -%}
            {%- if fq and fq != '' -%}<div><dt>Τελική τιμή</dt><dd>{{ fq }}</dd></div>{%- endif -%}
            <div><dt>Λογαριασμός</dt><dd style='font-family: var(--font-body); font-weight: 600; font-size: 1rem'>{{ customer.email }}</dd></div>
          </dl>

          {%- assign msg = customer.metafields.custom.project_message.value -%}
          {%- if msg and msg != '' -%}
            <div class='pj__msg'><small>Μήνυμα από τη Helia Web</small><p>{{ msg | newline_to_br }}</p></div>
          {%- endif -%}

          {%- if p < 3 -%}<p class='qt__hint' style='margin-top: 1.25rem'>Η προκαταβολή των €50 αφαιρείται από τη συνολική τιμή της ιστοσελίδας στον τελικό λογαριασμό.</p>{%- endif -%}
          <div class='pj__actions'>
            {%- if p < 3 -%}
              <a class='btn btn--yellow' href='/el/cart/60096830243200:1?checkout[email]={{ customer.email | url_encode }}'>Πληρωμή προκαταβολής €50</a>
            {%- endif -%}
            <a class='btn btn--ghost' href='tel:+35799238575'>Κλήση +357 99 238575</a>
            <a class='btn btn--ghost' href='mailto:christodoulos@heliaweb.com'>Στείλτε μου email</a>
          </div>
        {%- else -%}
          <div class='pj__signin'>
            <p>Συνδεθείτε με το email που χρησιμοποιήσατε για την προσφορά σας για να δείτε σε ποιο στάδιο βρίσκεται η ιστοσελίδα σας. Θα λάβετε έναν κωδικό μίας χρήσης με email, χωρίς κωδικό πρόσβασης.</p>
            <a class='btn btn--blue' href='/customer_authentication/login?return_to={{ "/el/pages/my-project" | url_encode }}'>Σύνδεση για να δω το έργο μου</a>
            <p class='qt__hint'>Δεν έχετε ακόμα προσφορά; <a href='/el/pages/get-a-quote' style='color: var(--blue); font-weight: 600'>Φτιάξτε την προσφορά σας</a></p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </main>
</div>
