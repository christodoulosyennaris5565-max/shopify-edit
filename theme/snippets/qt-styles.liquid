<style>
  .hw.qt-page { background: var(--mist); min-height: 100vh; }
  .hw .qt { padding-block: clamp(2rem, 6vw, 4rem) clamp(3rem, 8vw, 5rem); }
  .hw .qt__grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(1.25rem, 3vw, 2.5rem); align-items: start; }
  .hw .qt__head h1 { font-size: clamp(2rem, 5vw, 3rem); }
