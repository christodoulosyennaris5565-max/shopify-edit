  .hw .qt__opt { position: relative; display: flex; flex-direction: column; gap: 0.3rem; border: 1.5px solid var(--line); border-radius: 14px; padding: 1rem 1.1rem; cursor: pointer; background: #fff; transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s var(--ease); }
