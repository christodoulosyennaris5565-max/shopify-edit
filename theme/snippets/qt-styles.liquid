  .hw .qt__summary small { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: #b9c1d9; }
  .hw .qt__total { font-family: var(--font-display); font-weight: 800; font-size: 2.6rem; letter-spacing: -0.03em; line-height: 1.1; margin-top: 0.3rem; }
