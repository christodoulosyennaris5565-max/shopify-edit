  .hw .qt__card { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: clamp(1.25rem, 4vw, 2.25rem); margin-top: 1.75rem; }
  .hw .qt__progress { height: 6px; background: var(--blue-soft); border-radius: 999px; overflow: hidden; }
