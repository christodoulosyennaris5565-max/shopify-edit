<div class='hw'>
  <a class='skip' href='#main'>Skip to content</a>

  <header class='nav'>
    <div class='wrap nav__inner'>
      <a class='brand' href='/' aria-label='Helia Web home'>
        <svg class='brand__mark' viewBox='0 0 64 64' aria-hidden='true'><rect width='64' height='64' rx='14' fill='#2c52e8'/><path d='M17 14h8.2v14.3c2.1-2.8 5-4.2 8.6-4.2 6.1 0 9.6 4 9.6 10.7V50h-8.2V36.6c0-3.6-1.6-5.5-4.6-5.5-3.3 0-5.4 2.3-5.4 6.2V50H17z' fill='#fff'/><circle cx='50.5' cy='45.8' r='4.4' fill='#f5b83d'/></svg>
        Helia&nbsp;<small>Web</small>
      </a>
      <nav class='nav__links' aria-label='Main'>
        <a href='#pricing'>Pricing</a>
        <a href='#work'>Work</a>
        <a href='#industries'>Who it's for</a>
        <a href='#faq'>FAQ</a>
        <a class='btn btn--blue nav__cta' href='#contact'>Get a quote</a>
      </nav>
    </div>
  </header>

  <main id='main'>
    <section class='hero'>
      <div class='wrap hero__grid'>
        <div>
          <span class='eyebrow'>Website &amp; app studio</span>
          <h1>Your business, <span class='hl'>online</span> and looking sharp.</h1>
          <p class='hero__lead'>Helia Web designs and builds websites and apps for local businesses. You pay one fixed price, once. No monthly design fees and no surprise costs.</p>
          <div class='hero__ctas'>
            <a class='btn btn--blue' href='#contact'>Get a free quote</a>
            <a class='btn btn--ghost' href='#work'>See our work</a>
          </div>
          <p class='hero__note'>Call <a href='tel:+35799238575'><strong>+357 99 238575</strong></a> or email <a href='mailto:christodoulos@heliaweb.com'><strong>christodoulos@heliaweb.com</strong></a></p>
        </div>
        <div class='price-stack'>
          <div class='price-chip'>
            <div class='price-chip__label'>Websites</div>
            <div class='price-chip__price'>from €650<span>one-time</span></div>
            <p>Static websites for any business, designed and built for you.</p>
          </div>
          <div class='price-chip price-chip--blue'>
            <div class='price-chip__label'>Apps</div>
            <div class='price-chip__price'>from €1,000<span>one-time</span></div>
            <p>iPhone, Android and web apps. Tell me your idea.</p>
          </div>
        </div>
      </div>
    </section>

    <section class='section section--mist' id='pricing'>
      <div class='wrap'>
        <div class='section-head'>
          <span class='eyebrow'>Pricing</span>
          <h2>Simple prices. Paid once.</h2>
          <p>Every project starts with a free chat about what you need. You get a clear quote before any work begins.</p>
        </div>
        <div class='plans'>
          <article class='plan plan--featured'>
            <span class='plan__tag'>Most popular</span>
            <h3>Static website</h3>
            <div class='plan__price'>€650 <small>one-time fee</small></div>
            <p class='plan__desc'>A professional website that tells customers who you are and how to reach you.</p>
            <ul>
              <li>Custom design for your brand</li>
              <li>Looks great on phones, tablets and computers</li>
              <li>Services, menu, gallery, about and contact pages</li>
              <li>Call, email, WhatsApp and map buttons</li>
              <li>Set up so Google can find you</li>
            </ul>
            <a class='btn btn--blue btn--block' href='#contact'>Start my website</a>
          </article>
          <article class='plan'>
            <span class='plan__tag'>Apps</span>
            <h3>Mobile &amp; web app</h3>
            <div class='plan__price'>from €1,000</div>
            <p class='plan__desc'>A custom app for your business or idea, for iPhone, Android or the web.</p>
            <ul>
              <li>Designed around your users</li>
              <li>iPhone, Android or web</li>
              <li>Help getting it onto the app stores</li>
              <li>Final price depends on features</li>
            </ul>
            <a class='btn btn--ghost btn--block' href='#contact'>Talk about my app</a>
          </article>
          <article class='plan'>
            <span class='plan__tag'>Custom</span>
            <h3>Shops, bookings &amp; payments</h3>
            <div class='plan__price'>Quote</div>
            <p class='plan__desc'>Online shops, websites that take payments, and online booking systems.</p>
            <ul>
              <li>Online stores and product catalogues</li>
              <li>Online booking for restaurants, barbers and clinics</li>
              <li>Card payments and deposits</li>
              <li>Priced to fit your project</li>
            </ul>
            <a class='btn btn--ghost btn--block' href='#contact'>Ask for a quote</a>
          </article>
        </div>
        <div class='notice' role='note'>
          <svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='#b7801a' stroke-width='2' stroke-linecap='round' aria-hidden='true' style='flex:none;margin-top:2px'><circle cx='12' cy='12' r='10'/><path d='M12 8v4M12 16h.01'/></svg>
          <div><strong>The €650 price is for static websites.</strong> It doesn't cover websites that sell products or take any kind of payment, such as online shops or checkouts. For those, please <a href='#contact'>contact me</a> for a personal quote.</div>
        </div>
      </div>
    </section>

    <section class='section' id='work'>
      <div class='wrap'>
        <div class='section-head'>
          <span class='eyebrow'>Sample work</span>
          <h2>Projects we've built</h2>
          <p>One app and one website, to show what you can expect.</p>
        </div>
        <div class='work'>
          <article class='case'>
            <div>
              <span class='case__type'>Sample app</span>
              <h3>Crumbs: Student Finance</h3>
              <p>A money app for students. Upload a bank statement or screenshots, and Crumbs sorts every payment into categories, charts your spending day by day, and suggests cheaper swaps that save you money.</p>
              <ul class='case__tags'>
                <li>iPhone &amp; Android</li>
                <li>Spending charts</li>
                <li>Statement upload</li>
                <li>Smart savings tips</li>
              </ul>
              <a class='btn btn--blue' href='#contact'>Build an app like this</a>
            </div>
            <div class='case__media'>
              <div class='phones'>
                {%- assign s1 = images['helia-screen-1.webp'] -%}
                {%- assign s2 = images['helia-screen-3.webp'] -%}
                {%- if s1 != blank -%}
                  <div class='phone'>{{ s1 | image_url: width: 480 | image_tag: loading: 'lazy', alt: 'Crumbs app: monthly spending overview with a day-by-day chart', width: 480, height: 853 }}</div>
                {%- endif -%}
                {%- if s2 != blank -%}
                  <div class='phone'>{{ s2 | image_url: width: 480 | image_tag: loading: 'lazy', alt: 'Crumbs app: every payment sorted into categories', width: 480, height: 853 }}</div>
                {%- endif -%}
              </div>
            </div>
          </article>

          <article class='case'>
            <div>
              <span class='case__type'>Sample website</span>
              <h3>Solomou Woodworking</h3>
              <p>A website for a custom woodworking workshop. It shows their furniture and handmade pieces in a gallery and makes it easy for customers to get in touch about a commission.</p>
              <ul class='case__tags'>
                <li>Static website</li>
                <li>Project gallery</li>
                <li>Contact &amp; enquiries</li>
                <li>Mobile friendly</li>
              </ul>
              <a class='btn btn--ghost' href='https://solomouwoodworking.com' target='_blank' rel='noopener'>Visit solomouwoodworking.com
                <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17L17 7M8 7h9v9'/></svg>
              </a>
            </div>
            <div class='case__media'>
              <div class='browser' aria-hidden='true'>
                <div class='browser__bar'><i></i><i></i><i></i><span class='browser__url'>solomouwoodworking.com</span></div>
                <div class='wood'>
                  <div class='wood__nav'><span>Solomou</span><span>Work · About · Contact</span></div>
                  <div class='wood__title'>Handmade furniture,<br>built to last.</div>
                  <div class='wood__sub'>Custom woodwork, made to order.</div>
                  <div class='wood__grid'><span></span><span></span><span></span></div>
                  <span class='wood__btn'>Request a piece</span>
                </div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

