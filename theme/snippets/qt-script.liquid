<script>
(function () {
  /* Questions and prices. p = one-time price from (€), y = yearly price (€), m = monthly price (€), days = production time, h = title lines on the card, name = website name in the summary. */
  var Q = [
    { id: 'type', title: 'Which type of website do you need?', hint: 'Pick the one closest to what you have in mind.', opts: [
      { v: 'Static website', p: 450, days: 5, tag: 'Most popular', d: 'Pages that present your business: services, menu, gallery, opening hours and contact.' },
      { v: 'Animated website', p: 750, days: 8, d: 'Everything in a static website, plus smooth scroll animations and motion effects.' },
      { v: 'Website with online bookings', h: ['Website with', 'online bookings'], p: 450, y: 250, days: 5, bookings: 1, d: 'A static website plus an online booking system. The booking system is €250 per year.' },
      { v: 'Website with payments', h: ['Website with', 'payments'], p: 800, m: 55, days: 15, pay: 1, d: 'Take payments or sell products online. €55 per month (€660 per year) covers the payment and shop system.' }
    ] },
    { id: 'book', title: 'What will customers book?', when: function (a) { return a.type && a.type.bookings; }, opts: [
      { v: 'Tables (restaurant or café)' }, { v: 'Appointments (barber, salon, dentist)' }, { v: 'Rooms or stays' }, { v: 'Classes or sessions' }, { v: 'Something else' }
    ] },
    { id: 'paykind', title: 'What do you need it for?', when: function (a) { return a.type && a.type.pay; }, opts: [
      { v: 'Taking payments', name: 'Website with payments', d: 'For example deposits, bookings, services or invoices.' },
      { v: 'Selling products in an online shop', name: 'Website for an online shop', d: 'A shop where customers browse products and buy online.' }
    ] },
    { id: 'products', title: 'How many products will you sell?', hint: 'This helps me prepare your final quote.', when: function (a) { return a.paykind && a.paykind.name === 'Website for an online shop'; }, opts: [
      { v: 'Up to 20' }, { v: '20 to 100' }, { v: 'More than 100' }
    ] },
    { id: 'pages', title: 'How many pages do you need?', hint: 'A typical site has Home, About, Services, Gallery and Contact.', opts: [
      { v: '1 to 5 pages', d: 'Included in the price' }, { v: '6 to 10 pages', l: 'Extra pages (6 to 10)', p: 100 }, { v: 'More than 10 pages', l: 'Extra pages (10+)', p: 150 }
    ] },
    { id: 'lang', title: 'How many languages?', opts: [
      { v: '1 or 2 languages', d: 'Included in the price. For example Greek and English.' }, { v: '3 or more languages', l: 'Extra languages (3+)', p: 80 }
    ] },
    { id: 'photos', title: 'Do you have your own photos?', hint: 'I write all the text for your website, included in the price.', opts: [
      { v: 'Yes, I have my own photos', d: 'Included' }, { v: 'No, please add photos for me', d: 'Included' }, { v: 'Some, but I need a few more', d: 'Included' }
    ] },
    { id: 'extras', title: 'Would you like any extras?', hint: 'Choose as many as you like, or none.', multi: 1, opts: [
      { v: 'Google Maps & reviews', d: 'Included' }, { v: 'WhatsApp chat button', d: 'Included' },
      { v: 'Google Business profile setup', p: 50 }, { v: 'Newsletter sign-up', p: 50 }
    ] },
    { id: 'domain', title: 'Do you already have a domain name?', hint: 'For example yourbusiness.com', opts: [
      { v: 'Yes, I have one' }, { v: 'No, help me get one' }, { v: 'Not sure' }
    ] }
  ];

  var form = document.getElementById('qt-form');
  if (!form || document.getElementById('qt-done')) return;
  var box = document.getElementById('qt-steps');
  var next = document.getElementById('qt-next'), back = document.getElementById('qt-back'), send = document.getElementById('qt-send');
  var err = document.getElementById('qt-err');
  var eur = function (n) { return '€' + n.toLocaleString('en-US'); };
  var esc = function (t) { return String(t).replace(/[&<>']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;' }[c]; }); };

  Q.forEach(function (q) {
    var f = document.createElement('fieldset');
    f.className = 'qt__step'; f.hidden = true; f.dataset.step = q.id;
    var h = '<legend>' + esc(q.title) + '</legend>' + (q.hint ? '<p class="qt__hint">' + esc(q.hint) + '</p>' : '') + '<div class="qt__opts qt__opts--' + q.id + '">';
    q.opts.forEach(function (o, i) {
      var price = q.id === 'type' ? 'from ' + eur(o.p) + (o.y ? ' + ' + eur(o.y) + '/yr' : o.m ? ' + ' + eur(o.m) + '/mo' : '') : o.p ? '+' + eur(o.p) : '';
      h += '<label class="qt__opt"><input type="' + (q.multi ? 'checkbox' : 'radio') + '" name="qt_' + q.id + '" value="' + i + '">' +
        (o.tag ? '<span class="qt__tag">' + esc(o.tag) + '</span>' : '') +
        '<span class="qt__opt-top"><strong>' + (o.h ? o.h.map(esc).join('<br>') : esc(o.v)) + '</strong><span class="qt__price">' + price + '</span></span>' +
        (o.d ? '<small>' + esc(o.d) + '</small>' : '') + '</label>';
    });
    f.innerHTML = h + '</div>';
    box.appendChild(f);
  });

  function answers() {
    var a = {};
    Q.forEach(function (q) {
      var c = [].slice.call(form.querySelectorAll('[name=qt_' + q.id + ']:checked')).map(function (i) { return q.opts[+i.value]; });
      if (c.length) a[q.id] = q.multi ? c : c[0];
    });
    return a;
  }
  function active(a) {
    if (!a.type) a = { type: Q[0].opts[0] }; /* count steps as a static site until a type is chosen */
    return Q.filter(function (q) { return !q.when || q.when(a); });
  }

  var pos = 0;
  function steps() { return active(answers()).map(function (q) { return q.id; }).concat('review', 'contact'); }

  function totals(a) {
    var t = { total: 0, yearly: 0, monthly: 0, lines: [], text: [] };
    t.name = a.paykind ? a.paykind.name : a.type ? a.type.v : '';
    active(a).forEach(function (q) {
      var v = a[q.id]; if (!v) return;
      (q.multi ? v : [v]).forEach(function (o) {
        t.total += o.p || 0; t.yearly += (o.y || 0) + (o.m || 0) * 12; t.monthly += o.m || 0;
        if (o.p || q.id === 'type') t.lines.push([q.id === 'type' ? t.name : o.l || o.v, o.p ? (q.id === 'type' ? 'from ' + eur(o.p) : '+' + eur(o.p)) : 'included']);
        if (o.y) t.lines.push(['Booking system', eur(o.y) + '/yr']);
        if (o.m) t.lines.push([q.id === 'type' && a.paykind && a.paykind.name === 'Website for an online shop' ? 'Shop system' : 'Payment system', eur(o.m) + '/mo']);
      });
      t.text.push(q.title + ' ' + (q.multi ? v.map(function (o) { return o.v; }).join(', ') : v.v));
    });
    t.label = (t.total ? 'from ' : '') + eur(t.total);
    t.extra = t.monthly ? eur(t.monthly) + ' per month (' + eur(t.yearly) + ' per year)' : t.yearly ? eur(t.yearly) + ' per year' : '';
    t.short = t.monthly ? eur(t.monthly) + '/month' : t.yearly ? eur(t.yearly) + '/year' : '';
    t.days = a.type ? a.type.days : 0;
    return t;
  }

  function render() {
    var a = answers(), list = steps(), cur = list[pos], t = totals(a), qs = list.length - 2;
    [].forEach.call(form.querySelectorAll('.qt__step'), function (f) { f.hidden = f.dataset.step !== cur; });
    document.getElementById('qt-bar').style.width = Math.round(pos / (list.length - 1) * 100) + '%';
    document.getElementById('qt-count').textContent = cur === 'contact' ? 'Last step' : cur === 'review' ? 'Your summary' : 'Question ' + (pos + 1) + ' of ' + qs;
    back.hidden = pos === 0;
    next.hidden = cur === 'contact';
    send.hidden = cur !== 'contact';
    err.textContent = '';

    var dayText = t.days ? 'About ' + t.days + ' days' : '';
    document.getElementById('qt-total').textContent = t.label;
    document.getElementById('qt-mini').textContent = t.label + (t.short ? ' + ' + t.short : '');
    var y = document.getElementById('qt-yearly');
    y.hidden = !t.extra; y.textContent = '+ ' + t.extra;
    var d = document.getElementById('qt-days');
    d.hidden = !t.days; d.textContent = 'Ready in: ' + dayText.toLowerCase();
    document.getElementById('qt-lines').innerHTML = t.lines.length
      ? t.lines.map(function (l) { return '<li><span>' + esc(l[0]) + '</span><span>' + l[1] + '</span></li>'; }).join('')
      : '<li><span>Choose a website type to start</span><span></span></li>';
    if (a.type) {
      document.getElementById('qt-rv-type').textContent = t.name;
      document.getElementById('qt-rv-days').textContent = dayText;
      document.getElementById('qt-rv-price').textContent = t.label + (t.extra ? ' + ' + t.extra : '');
    }
    document.getElementById('qt-answers').value = t.text.join('\n');
    document.getElementById('qt-estimate').value = t.name + ': ' + t.label + ' one-time' + (t.extra ? ' + ' + t.extra : '') + (t.days ? ' · ' + dayText : '');
  }

  function valid() {
    var cur = steps()[pos], q = Q.filter(function (x) { return x.id === cur; })[0];
    if (q && !q.multi && !form.querySelector('[name=qt_' + q.id + ']:checked')) { err.textContent = 'Please choose an option to continue.'; return false; }
    return true;
  }
  function go(d) {
    if (d > 0 && !valid()) return;
    pos = Math.max(0, Math.min(steps().length - 1, pos + d));
    render();
    var h = form.querySelector('.qt__step:not([hidden]) legend');
    if (h) { h.setAttribute('tabindex', '-1'); h.focus({ preventScroll: true }); }
    form.closest('.qt__card').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  next.addEventListener('click', function () { go(1); });
  back.addEventListener('click', function () { go(-1); });
  form.addEventListener('change', render);
  form.addEventListener('submit', function (e) {
    var a = answers();
    if (!a.type) { e.preventDefault(); pos = 0; render(); return; }
    render();
    var t = totals(a);
    try {
      sessionStorage.setItem('hw-quote', JSON.stringify({
        email: form.querySelector('[name="contact[email]"]').value, type: t.name,
        price: t.label + (t.short ? ' + ' + t.short : ''), days: t.days
      }));
      sessionStorage.removeItem('hw-view'); sessionStorage.removeItem('hw-called'); sessionStorage.removeItem('hw-last');
    } catch (x) {}
  });

  var pre = new URLSearchParams(location.search).get('type');
  if (pre !== null && Q[0].opts[+pre]) { form.querySelector('[name=qt_type][value="' + (+pre) + '"]').checked = true; }
  render();
})();
</script>
