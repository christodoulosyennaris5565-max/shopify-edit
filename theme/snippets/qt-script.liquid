<script>
(function () {
  /* Questions and prices. p = one-time price (€), y = yearly price (€), from = price is a starting point. */
  var NOT_APP = function (a) { return a.type && !a.type.app; };
  var Q = [
    { id: 'type', title: 'Which type of website do you need?', hint: 'Pick the one closest to what you have in mind.', opts: [
      { v: 'Static website', p: 450, tag: 'Most popular', d: 'Pages that present your business: services, menu, gallery, opening hours and contact.' },
      { v: 'Animated website', p: 750, d: 'Everything in a static website, plus smooth scroll animations and motion effects.' },
      { v: 'Website with online bookings', p: 450, y: 250, bookings: 1, d: 'A static website plus an online booking system. The booking system is €250 per year.' },
      { v: 'Website with payments or an online shop', p: 900, from: 1, pay: 1, d: 'Sell products or take payments online. Final price after a short chat.' },
      { v: 'Mobile app', p: 1000, from: 1, app: 1, d: 'An iPhone, Android or web app. Final price after a short chat.' }
    ] },
    { id: 'book', title: 'What will customers book?', when: function (a) { return a.type && a.type.bookings; }, opts: [
      { v: 'Tables (restaurant or café)' }, { v: 'Appointments (barber, salon, dentist)' }, { v: 'Rooms or stays' }, { v: 'Classes or sessions' }, { v: 'Something else' }
    ] },
    { id: 'products', title: 'How many products or services will you sell?', hint: 'This helps me prepare your final quote.', when: function (a) { return a.type && a.type.pay; }, opts: [
      { v: 'Up to 20' }, { v: '20 to 100' }, { v: 'More than 100' }, { v: 'Payments only, no shop' }
    ] },
    { id: 'platform', title: 'Which platforms should the app work on?', when: function (a) { return a.type && a.type.app; }, opts: [
      { v: 'iPhone' }, { v: 'Android' }, { v: 'iPhone and Android' }, { v: 'Web app (in the browser)' }, { v: 'Not sure yet' }
    ] },
    { id: 'pages', title: 'How many pages do you need?', hint: 'A typical site has Home, About, Services, Gallery and Contact.', when: NOT_APP, opts: [
      { v: '1 to 5 pages', d: 'Included in the price' }, { v: '6 to 10 pages', l: 'Extra pages (6 to 10)', p: 100 }, { v: 'More than 10 pages', l: 'Extra pages (10+)', p: 150 }
    ] },
    { id: 'lang', title: 'How many languages?', when: NOT_APP, opts: [
      { v: '1 language', d: 'Included in the price' }, { v: '2 languages', l: 'Second language', p: 80, d: 'For example Greek and English' }, { v: '3 or more languages', l: 'Extra languages (3+)', p: 150 }
    ] },
    { id: 'logo', title: 'Do you have a logo?', opts: [
      { v: 'Yes, I have a logo' }, { v: 'No, design one for me', l: 'Logo design', p: 80 }
    ] },
    { id: 'content', title: 'Do you have the text and photos?', when: NOT_APP, opts: [
      { v: "Yes, I'll send them" }, { v: 'I need help writing the text', l: 'Text writing', p: 60 }, { v: 'Not sure yet' }
    ] },
    { id: 'extras', title: 'Would you like any extras?', hint: 'Choose as many as you like, or none.', multi: 1, when: NOT_APP, opts: [
      { v: 'Google Maps & reviews', d: 'Included' }, { v: 'WhatsApp chat button', d: 'Included' }, { v: 'Instagram feed', p: 40 },
      { v: 'Blog or news section', p: 100 }, { v: 'Google Business profile setup', p: 50 }, { v: 'Newsletter sign-up', p: 50 }
    ] },
    { id: 'domain', title: 'Do you already have a domain name?', hint: 'For example yourbusiness.com', when: NOT_APP, opts: [
      { v: 'Yes, I have one' }, { v: 'No, help me get one' }, { v: 'Not sure' }
    ] },
    { id: 'time', title: 'When do you need it?', opts: [
      { v: 'No rush' }, { v: 'Within a month' }, { v: 'Urgent, within 1 week', l: 'Urgent delivery (1 week)', p: 100 }
    ] }
  ];

  var form = document.getElementById('qt-form');
  if (!form || document.getElementById('qt-done')) return;
  var box = document.getElementById('qt-steps');
  var contact = form.querySelector('[data-step=contact]');
  var next = document.getElementById('qt-next'), back = document.getElementById('qt-back'), send = document.getElementById('qt-send');
  var err = document.getElementById('qt-err');
  var eur = function (n) { return '€' + n.toLocaleString('en-US'); };
  var esc = function (t) { return String(t).replace(/[&<>']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;' }[c]; }); };

  Q.forEach(function (q) {
    var f = document.createElement('fieldset');
    f.className = 'qt__step'; f.hidden = true; f.dataset.step = q.id;
    var h = '<legend>' + esc(q.title) + '</legend>' + (q.hint ? '<p class="qt__hint">' + esc(q.hint) + '</p>' : '') + '<div class="qt__opts">';
    q.opts.forEach(function (o, i) {
      var price = o.y ? eur(o.p) + ' + ' + eur(o.y) + '/yr' : o.p ? (q.id === 'type' ? (o.from ? 'from ' : '') + eur(o.p) : '+' + eur(o.p)) : '';
      h += '<label class="qt__opt"><input type="' + (q.multi ? 'checkbox' : 'radio') + '" name="qt_' + q.id + '" value="' + i + '">' +
        (o.tag ? '<span class="qt__tag">' + esc(o.tag) + '</span>' : '') +
        '<span class="qt__opt-top"><strong>' + esc(o.v) + '</strong><span class="qt__price">' + price + '</span></span>' +
        (o.d ? '<small>' + esc(o.d) + '</small>' : '') + '</label>';
    });
    f.innerHTML = h + '</div>';
    box.appendChild(f);
  });

  function answers() {
    var a = {};
    Q.forEach(function (q) {
      var c = [].slice.call(form.querySelectorAll('[name=qt_' + q.id + ']:checked')).map(function (i) { return q.opts[+i.value]; });
      if (c.length) a[q.id] = q.multi ? c : c[0];
    });
    return a;
  }
  function active(a) {
    if (!a.type) a = { type: Q[0].opts[0] }; /* count steps as a static site until a type is chosen */
    return Q.filter(function (q) { return !q.when || q.when(a); });
  }

  var pos = 0;
  function steps() { return active(answers()).map(function (q) { return q.id; }).concat('contact'); }

  function render() {
    var a = answers(), list = steps(), cur = list[pos];
    [].forEach.call(form.querySelectorAll('.qt__step'), function (f) { f.hidden = f.dataset.step !== cur; });
    document.getElementById('qt-bar').style.width = Math.round(pos / (list.length - 1) * 100) + '%';
    document.getElementById('qt-count').textContent = cur === 'contact' ? 'Last step' : 'Question ' + (pos + 1) + ' of ' + (list.length - 1);
    back.hidden = pos === 0;
    next.hidden = cur === 'contact';
    send.hidden = cur !== 'contact';
    err.textContent = '';

    var total = 0, yearly = 0, from = false, lines = [], text = [];
    active(a).forEach(function (q) {
      var v = a[q.id]; if (!v) return;
      (q.multi ? v : [v]).forEach(function (o) {
        total += o.p || 0; yearly += o.y || 0; if (o.from) from = true;
        if (o.p || q.id === 'type') lines.push([o.l || o.v, o.p ? (q.id === 'type' ? eur(o.p) : '+' + eur(o.p)) : 'included']);
        if (o.y) lines.push(['Booking system', eur(o.y) + '/yr']);
      });
      text.push(q.title + ' ' + (q.multi ? v.map(function (o) { return o.v; }).join(', ') : v.v));
    });
    var label = (from ? 'from ' : '') + eur(total);
    document.getElementById('qt-total').textContent = label;
    document.getElementById('qt-mini').textContent = label + (yearly ? ' + ' + eur(yearly) + '/year' : '');
    var y = document.getElementById('qt-yearly');
    y.hidden = !yearly; y.textContent = '+ ' + eur(yearly) + ' per year';
    document.getElementById('qt-lines').innerHTML = lines.length
      ? lines.map(function (l) { return '<li><span>' + esc(l[0]) + '</span><span>' + l[1] + '</span></li>'; }).join('')
      : '<li><span>Choose a website type to start</span><span></span></li>';
    document.getElementById('qt-answers').value = text.join('\n');
    document.getElementById('qt-estimate').value = label + ' one-time' + (yearly ? ' + ' + eur(yearly) + ' per year' : '');
  }

  function valid() {
    var cur = steps()[pos], q = Q.filter(function (x) { return x.id === cur; })[0];
    if (q && !q.multi && !form.querySelector('[name=qt_' + q.id + ']:checked')) { err.textContent = 'Please choose an option to continue.'; return false; }
    return true;
  }
  function go(d) {
    if (d > 0 && !valid()) return;
    pos = Math.max(0, Math.min(steps().length - 1, pos + d));
    render();
    var h = form.querySelector('.qt__step:not([hidden]) legend');
    if (h) { h.setAttribute('tabindex', '-1'); h.focus({ preventScroll: true }); }
    form.closest('.qt__card').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  next.addEventListener('click', function () { go(1); });
  back.addEventListener('click', function () { go(-1); });
  form.addEventListener('change', function (e) {
    render();
    if (e.target.type === 'radio') setTimeout(function () { go(1); }, 250);
  });
  form.addEventListener('submit', function (e) { render(); if (!answers().type) { e.preventDefault(); pos = 0; render(); } });

  var pre = new URLSearchParams(location.search).get('type');
  if (pre !== null && Q[0].opts[+pre]) { form.querySelector('[name=qt_type][value="' + (+pre) + '"]').checked = true; pos = 1; }
  render();
})();
</script>
